# Database connection (production-ready guidance)
# For production, set `DATABASE_URL` as a secret in your hosting provider or CI.
# Example Render (production):
# DATABASE_URL="postgresql://ecommerce_saas_db_erqo_user:<PASSWORD>@dpg-d9qs8fmgekts73e9mdd0-a.frankfurt-postgres.render.com:5432/ecommerce_saas_db_erqo?sslmode=require"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce_saas
DATABASE_URL="postgresql://postgres:postgres@db:5432/ecommerce_saas"

# Redis cache and rate limiting
REDIS_URL=redis://redis:6379

# NextAuth
NEXTAUTH_SECRET=replace-with-a-secure-random-value
NEXTAUTH_URL=http://localhost:3000

# Environment
NODE_ENV=development
