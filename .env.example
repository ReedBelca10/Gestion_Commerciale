# Database connection
# If you use Supabase, replace DATABASE_URL with the Supabase PostgreSQL connection string.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce_saas
DATABASE_URL="postgresql://postgres:postgres@db:5432/ecommerce_saas"

# Redis cache and rate limiting
REDIS_URL=redis://redis:6379

# NextAuth
NEXTAUTH_SECRET=replace-with-a-secure-random-value
NEXTAUTH_URL=http://localhost:3000

# Environment
NODE_ENV=development
